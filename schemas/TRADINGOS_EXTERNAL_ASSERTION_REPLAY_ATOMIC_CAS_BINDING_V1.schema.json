{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "TRADINGOS_EXTERNAL_ASSERTION_REPLAY_ATOMIC_CAS_BINDING_V1.schema.json",
  "title": "TradingOS R87 External Assertion Replay Atomic CAS Binding V1",
  "type": "object",
