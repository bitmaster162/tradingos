    "challenge_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cas_generation_from": {"type": "integer", "minimum": 0, "maximum": 2147483646},
    "cas_generation_to": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "cas_precondition_bound": {"const": true},
    "atomic_transition_candidate_verified": {"const": true},
    "durable_commit_proven": {"const": false},
    "durable_single_use_enforced": {"const": false},
    "global_current_state_verified": {"const": false},
    "concurrent_writer_exclusion_proven": {"const": false},
    "registry_write_performed": {"const": false},
    "assertion_freshness_verified": {"const": false},
    "liveness_verified": {"const": false},
    "verifier_trust_root_verified": {"const": false},
    "review_identity_verified": {"const": false},
    "physical_human_presence_proven": {"const": false},
    "distinct_reviewer_count_allowed": {"const": false},
    "consensus_inference_allowed": {"const": false},
    "approval_state_allowed": {"const": false},
    "shadow_only": {"const": true},
    "human_review_only": {"const": true},
    "attestation_set_consumption_authority": {"const": "NONE"},
    "memory_write_authority": {"const": "NONE"},
    "policy_update_allowed": {"const": false},
    "live_decision_feedback_allowed": {"const": false},
    "live_decision_use_allowed": {"const": false},
    "model_selection_use_allowed": {"const": false},
