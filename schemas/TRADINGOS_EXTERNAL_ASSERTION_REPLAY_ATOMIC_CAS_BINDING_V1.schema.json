  "properties": {
    "schema": {"const": "tradingos.external_assertion_replay_atomic_cas_binding.v1"},
    "binding_id": {"type": "string", "pattern": "^[0-9a-f]{24}$"},
    "r86_binding_id": {"type": "string", "pattern": "^[0-9a-f]{24}$"},
    "r86_binding_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "r85_binding_id": {"type": "string", "pattern": "^[0-9a-f]{24}$"},
    "r84_binding_id": {"type": "string", "pattern": "^[0-9a-f]{24}$"},
    "atomic_cas_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
